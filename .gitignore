# Root-only rules. Each subproject (reconstruction/, video_ingestion_agent/,
# robotic_grounding/) has its own .gitignore for package-specific artifacts.
**.egg-info

# Editor workspace files
*.code-workspace

# Local direnv overrides (only meaningful at repo root)
.envrc.local

# Cloud credentials are provisioned per machine and must never be committed.
# The directory itself is tracked (via its README) so the expected location and
# file format are discoverable without a working copy of the secrets.
/credentials/*
!/credentials/README.md
